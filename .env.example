# QL Learn environment variables. Copy to .env.local (gitignored) and fill in.
# Setup steps for each service: Linear DEV-81.

# MongoDB Atlas connection string, database name `ql-learn`
DATABASE_URI=
# Payload encryption secret: `openssl rand -hex 32` (different per environment)
PAYLOAD_SECRET=
# Absolute site URL: http://localhost:3000 locally, https://quarterlylearnings.com in Netlify
NEXT_PUBLIC_SERVER_URL=

# Stripe secret key (test mode until launch)
STRIPE_SECRET_KEY=
# Webhook signing secret: from `stripe listen` locally, from the Stripe dashboard endpoint in Netlify
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2 bucket name
S3_BUCKET=
# R2 S3 API endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# R2 API token access key ID (Object Read & Write, scoped to the bucket)
S3_ACCESS_KEY_ID=
# R2 API token secret access key
S3_SECRET_ACCESS_KEY=
# Public base URL for bucket objects (r2.dev URL or custom domain)
S3_PUBLIC_URL=

# Resend API key (sending access only)
RESEND_API_KEY=
# Recipient for internal alerts such as duplicate purchases
ADMIN_NOTIFY_EMAIL=
